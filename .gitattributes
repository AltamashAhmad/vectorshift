# Set default behavior to automatically normalize line endings
* text=auto

# Binary files (should not be modified)
*.pdf binary
*.rdb binary
*.pack binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary

# Documents
*.md text diff=markdown
*.txt text
*.json text

# Scripts
*.sh text eol=lf
*.py text diff=python
*.js text
*.jsx text
*.ts text
*.tsx text

# Configuration files
*.yml text
*.yaml text
*.toml text
*.lock text
*.env.example text 